# ─────────────────────────────────────────────────────────────
# JPER Community — .env.local template
# Copy file ini ke .env.local lalu isi nilai yang benar.
# JANGAN commit .env.local ke git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (server-only, jangan pakai NEXT_PUBLIC) ──────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/keys

# ── Supabase (client-side - boleh NEXT_PUBLIC) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# ── Firebase (public — boleh NEXT_PUBLIC) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX  # opsional

# ── Vercel Blob (file storage — materi & submission) ──────────
# Buat Blob Store di: https://vercel.com/dashboard > Storage > Blob
# Copy token "Read & Write" ke sini.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
